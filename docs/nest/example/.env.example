# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量都会经过 src/config/env.validation.ts 的 zod 校验。
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# CORS 白名单，逗号分隔。生产环境改成真实前端域名。
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# --- 数据库（MySQL 8.4）-----------------------------------------------------
# 方式 A：优先使用完整连接串。
DATABASE_URL=mysql://meeting:meeting@127.0.0.1:3306/meeting_booking
# 方式 B：不设置 DATABASE_URL 时使用下面逐项配置。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=meeting
DB_PASSWORD=meeting
DB_NAME=meeting_booking

# 仅开发环境使用 true：启动时自动同步表结构。
# 生产环境必须关闭，并通过迁移管理 schema。
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Redis（可选）-----------------------------------------------------------
# 留空或不设置时统计缓存自动降级为直接查库，应用仍可启动。
REDIS_URL=redis://127.0.0.1:6379

# --- JWT --------------------------------------------------------------------
# 生产环境务必替换成高强度随机值（至少 32 字符），并保证两个 secret 不同。
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_REFRESH_EXPIRES_IN=7d

# --- 限流（毫秒 / 每窗口请求数）--------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
