# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量都会经过 src/config/env.validation.ts 的 zod 校验。
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# CORS 白名单，逗号分隔。生产环境改成真实前端域名。
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# --- 数据库（PostgreSQL 17）-------------------------------------------------
# 与 docker-compose.yml 里的库名/用户/密码保持一致；Prisma 8 只认 postgres:// 或 postgresql://。
DATABASE_URL=postgresql://meeting:meeting@127.0.0.1:5432/meeting_booking
# 迁移 / seed 专用的直连地址（可选）。不设置时回落到 DATABASE_URL；
# 生产上用连接池（如 pgbouncer）时，这里填绕过池的直连地址。
DIRECT_URL=postgresql://meeting:meeting@127.0.0.1:5432/meeting_booking

# --- Redis（可选）-----------------------------------------------------------
# 留空或不设置时统计缓存自动降级为直接查库，应用仍可启动。
REDIS_URL=redis://127.0.0.1:6379

# --- JWT --------------------------------------------------------------------
# 生产环境务必替换成高强度随机值（至少 32 字符），并保证两个 secret 不同。
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_REFRESH_EXPIRES_IN=7d

# --- 限流（毫秒 / 每窗口请求数）--------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
